{
  "permissions": {
    "deny": [
      "Read(./**/node_modules/**/*)",
      "Read(./**/vendor/**/*)",
      "Read(./**/third_party/**/*)",
      "Read(./**/dist/**/*)",
      "Read(./**/build/**/*)",
      "Read(./**/target/**/*)",
      "Read(./**/out/**/*)",
      "Read(./**/coverage/**/*)",
      "Read(./**/generated/**/*)",
      "Read(./**/*.generated.*)",
      "Read(./**/*.min.js)",
      "Read(./**/*.map)",
      "Read(./**/package-lock.json)",
      "Read(./**/pnpm-lock.yaml)",
      "Read(./**/yarn.lock)"
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "MAX_MCP_OUTPUT_TOKENS": "10000"
  },
  "worktree": {
    "sparsePaths": [
      ".claude",
      "RUTA/DEL/SUBSISTEMA",
      "RUTA/DE/LO/COMPARTIDO"
    ],
    "symlinkDirectories": [
      "node_modules"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/filtrar-salida-tests.sh\""
          }
        ]
      }
    ]
  }
}
